# Environment Configuration
# Copy this file to .env and update values for your deployment

# Application
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_tracker
DB_USER=postgres
DB_PASS=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379

# MinIO Configuration (Optional - uses local storage if not configured)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Security
JWT_SECRET=your-super-secret-key-change-in-production-make-it-long-and-random
CORS_ORIGIN=*

# File Upload Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info