{
  "name": "construction-issue-tracker",
  "version": "1.0.0",
  "description": "Open-source construction project issue management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "redis": "^4.6.7",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "multer": "^1.4.5",
    "minio": "^7.1.1",
    "ws": "^8.13.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.7.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  },
  "keywords": ["construction", "issue-tracking", "project-management", "self-hosted", "open-source"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ViranjPatel/construction-issue-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/ViranjPatel/construction-issue-tracker/issues"
  },
  "homepage": "https://github.com/ViranjPatel/construction-issue-tracker#readme"
}